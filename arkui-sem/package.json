{
  "name": "arkui-sem",
  "version": "0.2.0",
  "private": true,
  "description": "ArkTS/ArkUI semantic lint for the coding-agent loop, as an opencode plugin",
  "type": "module",
  "main": "dist/opencode.js",
  "exports": {
    ".": "./dist/opencode.js"
  },
  "bin": {
    "arkui-sem": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node test/arkui-sem.test.mjs",
    "check:fixtures": "node dist/cli.js check test/fixtures --format agent",
    "install:project": "node scripts/install.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
